# Relay (maintenance-hub) — OVH production env. Copy to .env.production, fill in.
# NEVER commit .env.production. Only this .example is tracked.

# Public subdomain (DNS A-record → the shared OVH box IP)
DOMAIN=relay.rentatrix.com

# Postgres (self-hosted relay-db container). openssl rand -hex 24
DB_PASSWORD=

# Session signing (>=32 chars). openssl rand -hex 32
JWT_SECRET=

# AI for intake classification / quote parsing (OpenRouter preferred).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Outreach stays SIMULATED (set in compose) until you add real creds here and
# flip OUTREACH_SIMULATE=0 in the compose:
#   TWILIO_ACCOUNT_SID=  TWILIO_AUTH_TOKEN=  SMTP_HOST=  SMTP_USERNAME=  SMTP_PASSWORD=
